---
import '../styles/global.css';
import { locales, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  subpath?: string;   // partie d'URL après la locale, ex. "modules/var/"
  trackAm?: boolean;
  progress?: boolean;
}
const { locale, title, description = '', subpath = '', trackAm = false, progress = false } = Astro.props;
const t = ui[locale];
const base = import.meta.env.BASE_URL; // ex. "/avenir-web/"
const link = (loc: string, sub = subpath) => `${base}${loc}/${sub}`;
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Avenir</title>
  {description && <meta name="description" content={description} />}
</head>
<body data-active-lang={locale} class={trackAm ? 'track-am' : undefined}>
  {progress && <div class="progress-bar"></div>}

  <header class="site-header">
    <div class="wrap nav">
      <div class="brand">
        <a href={link(locale, '')}><span class="logo">Avenir<b>.</b></span></a>
        <span class="tag">{t.tag}</span>
      </div>
      <div class="spacer"></div>
      <nav class="nav-links">
        <a href={`${link(locale, '')}#parcours`}>{t.tracks}</a>
        <a href={`${link(locale, '')}#curriculum`}>{t.curriculum}</a>
        <a href={link(locale, 'solutions/')}>{t.solutions}</a>
        <a href={link(locale, '')}>{t.home}</a>
      </nav>
      <div class="controls">
        <div class="lang-toggle" role="group" aria-label="Language">
          {locales.map((loc) => (
            <a href={link(loc)} class={loc === locale ? 'active' : undefined} hreflang={loc}>{loc.toUpperCase()}</a>
          ))}
        </div>
        <button id="theme-btn" class="icon-btn" aria-label="Theme">☾</button>
        <button id="menu-btn" class="icon-btn menu-btn" aria-label="Menu">☰</button>
      </div>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="wrap foot">
      <div class="brand"><span class="logo">Avenir<b>.</b></span></div>
      <p>{t.footer}</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var LS_THEME = "avenir-theme";
      function get(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
      function set(k,v){ try { localStorage.setItem(k,v); } catch(e){} }
      function currentTheme(){
        var a = document.documentElement.getAttribute("data-theme");
        if (a) return a;
        return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      function icon(){ var b=document.getElementById("theme-btn"); if(b) b.textContent = currentTheme()==="dark" ? "☀" : "☾"; }
      function applyTheme(th){
        if (th){ document.documentElement.setAttribute("data-theme", th); set(LS_THEME, th); }
        else { document.documentElement.removeAttribute("data-theme"); }
        icon();
      }
      var saved = get(LS_THEME);
      applyTheme(saved === "light" || saved === "dark" ? saved : null);

      document.addEventListener("DOMContentLoaded", function () {
        var tb = document.getElementById("theme-btn");
        if (tb) tb.addEventListener("click", function(){ applyTheme(currentTheme()==="dark" ? "light" : "dark"); });

        var mb = document.getElementById("menu-btn");
        var nl = document.querySelector(".nav-links");
        if (mb && nl) mb.addEventListener("click", function(){
          var open = nl.style.display === "flex";
          nl.style.display = open ? "" : "flex";
          nl.style.position="absolute"; nl.style.flexDirection="column"; nl.style.top="64px";
          nl.style.right="16px"; nl.style.background="var(--surface)"; nl.style.border="1px solid var(--border)";
          nl.style.borderRadius="12px"; nl.style.padding="8px"; nl.style.boxShadow="var(--shadow-lg)";
        });

        var toc = document.querySelector(".toc");
        var bar = document.querySelector(".progress-bar");
        if (toc || bar) {
          var hs = Array.prototype.slice.call(document.querySelectorAll(".module-body h2[id]"));
          var ls = toc ? Array.prototype.slice.call(toc.querySelectorAll("a")) : [];
          var onScroll = function(){
            if (bar){ var h=document.documentElement; var p=h.scrollTop/(h.scrollHeight-h.clientHeight); bar.style.width = Math.max(0,Math.min(1,p))*100 + "%"; }
            if (hs.length && ls.length){
              var pos = window.scrollY + 120, cur = hs[0].id;
              hs.forEach(function(hd){ if (hd.offsetTop <= pos) cur = hd.id; });
              ls.forEach(function(a){ a.classList.toggle("active", a.getAttribute("href") === "#" + cur); });
            }
          };
          window.addEventListener("scroll", onScroll, { passive: true }); onScroll();
        }
      });

      window.avenirAnswer = function (btn, correct) {
        var q = btn.closest(".q");
        if (q.getAttribute("data-done") === "1") return;
        q.setAttribute("data-done", "1");
        var opts = q.querySelectorAll(".opt");
        opts.forEach(function(o){ o.disabled = true; });
        if (correct) { btn.classList.add("correct"); }
        else { btn.classList.add("wrong"); opts.forEach(function(o){ if (o.getAttribute("data-correct")==="1") o.classList.add("correct"); }); }
        var ex = q.querySelector(".explain"); if (ex) ex.classList.add("show");
      };
    })();
  </script>
</body>
</html>
