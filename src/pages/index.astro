---
// Redirection racine vers la langue par défaut (site statique).
const base = import.meta.env.BASE_URL;
const target = `${base}fr/`;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <link rel="canonical" href={target} />
  <title>Avenir</title>
</head>
<body>
  <p>Redirection… <a href={target}>Avenir</a></p>
</body>
</html>
