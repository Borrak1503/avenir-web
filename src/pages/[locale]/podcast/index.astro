---
import Base from '../../../layouts/Base.astro';
import { locales } from '../../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params;
const L = locale as string;
const base = import.meta.env.BASE_URL;
const mod = (slug: string) => `${base}${L}/modules/${slug}/`;

const T: Record<string, any> = {
  fr: {
    title: 'Podcast',
    eyebrow: 'Le podcast Avenir',
    h1: '20 minutes pour comprendre',
    intro: "Chaque épisode prend une idée de finance et la rend limpide, en deux voix : une qui questionne, une qui explique. Un épisode par module, à écouter dans l'ordre ou en piochant.",
    live: 'Épisode pilote', soon: 'À venir',
    linkModule: 'Découvrir le module →',
    soonMsg: 'Bientôt en ligne',
  },
  en: {
    title: 'Podcast',
    eyebrow: 'The Avenir podcast',
    h1: '20 minutes to understand',
    intro: 'Each episode takes one idea in finance and makes it clear, in two voices: one that questions, one that explains. One episode per module, to follow in order or dip into.',
    live: 'Pilot episode', soon: 'Coming soon',
    linkModule: 'Explore the module →',
    soonMsg: 'Coming online soon',
  },
  nl: {
    title: 'Podcast',
    eyebrow: 'De Avenir-podcast',
    h1: '20 minuten om te begrijpen',
    intro: 'Elke aflevering neemt één idee uit de finance en maakt het helder, in twee stemmen: één die vraagt, één die uitlegt. Eén aflevering per module, in volgorde te volgen of om uit te kiezen.',
    live: 'Piloot­aflevering', soon: 'Binnenkort',
    linkModule: 'Ontdek de module →',
    soonMsg: 'Binnenkort online',
  },
};
const t = T[L];

const EPISODES = [
  { n: 1, dur: '~20 min', live: true, slug: 'am1',
    title: { fr: 'Les fondamentaux de la gestion d’actifs', en: 'Foundations of asset management', nl: 'Grondslagen van vermogensbeheer' },
    desc: {
      fr: "Où va l’argent que vous confiez, qui le gère, sous quelles règles, et pourquoi les frais décident presque tout.",
      en: 'Where the money you entrust goes, who manages it, under which rules, and why fees decide almost everything.',
      nl: 'Waar het geld dat u toevertrouwt naartoe gaat, wie het beheert, onder welke regels, en waarom kosten bijna alles bepalen.' } },
  { n: 2, dur: '~20 min', live: false, slug: 'am2',
    title: { fr: 'La théorie moderne du portefeuille', en: 'Modern portfolio theory', nl: 'Moderne portefeuilletheorie' },
    desc: {
      fr: "Diversifier pour réduire le risque sans sacrifier le rendement : l’intuition de Markowitz, en clair.",
      en: 'Diversify to cut risk without giving up return: the Markowitz intuition, made plain.',
      nl: 'Diversifiëren om risico te verlagen zonder rendement op te geven: de intuïtie van Markowitz, helder uitgelegd.' } },
  { n: 3, dur: '~20 min', live: false, slug: 'am3',
    title: { fr: 'Le modèle CAPM', en: 'The CAPM', nl: 'Het CAPM' },
    desc: {
      fr: "Risque de marché, bêta et prime de risque : ce qu’un investisseur est vraiment payé pour supporter.",
      en: 'Market risk, beta and the risk premium: what an investor is really paid to bear.',
      nl: 'Marktrisico, bèta en de risicopremie: waarvoor een belegger echt wordt betaald om te dragen.' } },
  { n: 4, dur: '~20 min', live: false, slug: 'am4',
    title: { fr: 'Les classes d’actifs', en: 'The asset classes', nl: 'De activaklassen' },
    desc: {
      fr: 'Actions, obligations, immobilier, matières premières, monétaire : à quoi sert chacune dans un portefeuille.',
      en: 'Equities, bonds, real estate, commodities, cash: what each one is for in a portfolio.',
      nl: 'Aandelen, obligaties, vastgoed, grondstoffen, cash: waarvoor elk dient in een portefeuille.' } },
  { n: 5, dur: '~20 min', live: false, slug: 'frm1',
    title: { fr: 'Panorama du risque financier', en: 'The map of financial risk', nl: 'Het landschap van financieel risico' },
    desc: {
      fr: 'Marché, crédit, liquidité, opérationnel : la carte des risques qu’une banque doit gérer.',
      en: 'Market, credit, liquidity, operational: the map of risks a bank must manage.',
      nl: 'Markt, krediet, liquiditeit, operationeel: de kaart van risico’s die een bank moet beheren.' } },
  { n: 6, dur: '~20 min', live: false, slug: 'var',
    title: { fr: 'La Value at Risk', en: 'Value at Risk', nl: 'Value at Risk' },
    desc: {
      fr: 'Un seul chiffre pour résumer le risque d’un portefeuille : sa promesse, et ses angles morts.',
      en: 'A single number to summarise a portfolio’s risk: its promise, and its blind spots.',
      nl: 'Eén cijfer om het risico van een portefeuille samen te vatten: de belofte, en de blinde vlekken.' } },
];
---
<Base locale={locale as any} title={t.title} subpath="podcast/">
  <main class="wrap pod-page">
    <div class="pod-head">
      <div class="pod-eyebrow">🎧 {t.eyebrow}</div>
      <h1>{t.h1}</h1>
      <p>{t.intro}</p>
    </div>

    <div class="pod-timeline">
      {EPISODES.map((ep) => (
        <div class={ep.live ? 'pod-item live' : 'pod-item'}>
          <span class="pod-node"></span>
          <article class="pod-card">
            {/* Pour une vraie capture : déposez l'image dans public/podcast/epN.jpg
                et remplacez le bloc .play par <img src={`${base}podcast/ep${ep.n}.jpg`} alt="" /> */}
            <div class="pod-thumb">
              <span class="epnum">EP {String(ep.n).padStart(2, '0')}</span>
              <span class="play">▶</span>
            </div>
            <div class="pod-body">
              <div class="pod-chips">
                <span class={ep.live ? 'pod-chip live' : 'pod-chip soon'}>{ep.live ? t.live : t.soon}</span>
                <span class="pod-chip">{ep.dur}</span>
              </div>
              <h3>{ep.title[L]}</h3>
              <p>{ep.desc[L]}</p>
              {ep.live
                ? <a class="pod-link" href={mod(ep.slug)}>{t.linkModule}</a>
                : <span class="pod-soonmsg">{t.soonMsg}</span>}
            </div>
          </article>
        </div>
      ))}
    </div>
  </main>
</Base>
