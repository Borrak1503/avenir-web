---
import Base from '../../../layouts/Base.astro';
import { locales, ui, withBase } from '../../../i18n';
import varMod from '../../../data/modules/var.json';
import am1Mod from '../../../data/modules/am1.json';
import am2Mod from '../../../data/modules/am2.json';
import am3Mod from '../../../data/modules/am3.json';
import am4Mod from '../../../data/modules/am4.json';
import am5Mod from '../../../data/modules/am5.json';
import am6Mod from '../../../data/modules/am6.json';
import am7Mod from '../../../data/modules/am7.json';
import am8Mod from '../../../data/modules/am8.json';
import frm1Mod from '../../../data/modules/frm1.json';
import frm3Mod from '../../../data/modules/frm3.json';
import frm4Mod from '../../../data/modules/frm4.json';
import frm5Mod from '../../../data/modules/frm5.json';
import frm6Mod from '../../../data/modules/frm6.json';
import frm7Mod from '../../../data/modules/frm7.json';
import frm8Mod from '../../../data/modules/frm8.json';
import am4actionsMod from '../../../data/modules/am4-actions.json';
import am4obligationsMod from '../../../data/modules/am4-obligations.json';
import am4immobilierMod from '../../../data/modules/am4-immobilier.json';
import am4matieresMod from '../../../data/modules/am4-matieres.json';
import am4monetaireMod from '../../../data/modules/am4-monetaire.json';

const MODULES = [am1Mod, am2Mod, am3Mod, am4Mod, am4actionsMod, am4obligationsMod, am4immobilierMod, am4matieresMod, am4monetaireMod, am5Mod, am6Mod, am7Mod, am8Mod, frm1Mod, frm3Mod, frm4Mod, frm5Mod, frm6Mod, frm7Mod, frm8Mod, varMod] as any[];

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params;
const loc = locale as string;
const t = ui[loc as 'fr' | 'en' | 'nl'];
const base = import.meta.env.BASE_URL;
---
<Base locale={locale as any} title={t.solutionsTitle} subpath="solutions/">
  <section>
    <div class="wrap" style="max-width:900px">
      <div class="section-head">
        <div class="kicker">{t.solutions}</div>
        <h2>{t.solutionsTitle}</h2>
        <p>{t.solutionsIntro}</p>
      </div>

      {MODULES.filter((m) => m.exercises && m.exercises.length).map((m) => (
        <div style="margin-bottom:40px">
          <h3 style="font-family:var(--serif);font-size:22px;border-bottom:2px solid var(--border);padding-bottom:10px">
            <a href={`${base}${loc}/modules/${m.slug}/`}>{m.titles[loc]}</a>
          </h3>
          {m.exercises.map((ex: any) => (
            <div class="exo">
              <div class="ehead"><span class="eid">{ex.id}</span></div>
              <div class="estatement"><strong>{t.statement} — </strong><span set:html={withBase(ex.statement[loc])} /></div>
              <div class="ans"><strong>{t.answer} — </strong><span set:html={withBase(ex.answer[loc])} /></div>
            </div>
          ))}
          <p style="margin-top:14px">
            <a class="btn btn-outline" href={`${base}${loc}/modules/${m.slug}/`}>{t.backToModule} →</a>
          </p>
        </div>
      ))}
    </div>
  </section>
</Base>
