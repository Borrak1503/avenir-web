---
import Base from '../../../layouts/Base.astro';
import { locales, withBase } from '../../../i18n';
import varMod from '../../../data/modules/var.json';
import am1Mod from '../../../data/modules/am1.json';
import am2Mod from '../../../data/modules/am2.json';

const MODULES: Record<string, any> = { var: varMod, am1: am1Mod, am2: am2Mod };

export function getStaticPaths() {
  const slugs = ['var', 'am1', 'am2'];
  const paths: any[] = [];
  for (const locale of locales) {
    for (const slug of slugs) {
      paths.push({ params: { locale, slug } });
    }
  }
  return paths;
}

const { locale, slug } = Astro.params;
const mod = MODULES[slug as string];
const body = withBase(mod.body[locale as string]);
const calc: string = mod.calc || '';
---
<Base
  locale={locale as any}
  title={mod.titles[locale as string]}
  subpath={`modules/${slug}/`}
  trackAm={mod.trackAm}
  progress={true}
>
  <Fragment set:html={body} />
  {calc && <script is:inline set:html={calc} />}
</Base>
